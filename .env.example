# =====================================================================
# InkRAG 环境变量示例（复制为 .env 后按需修改；.env 不入库）
#
# 变量分四组：面板端口 / 面板鉴权机密 / 实时事件服务 / 运行时与产物 / 监控
# 标记说明：
#   [必配-生产]  生产部署必须显式注入，否则存在安全或功能风险
#   [可选]      有合理默认值，按需覆盖
# =====================================================================


# ---------------------------------------------------------------------
# 一、面板端口
# ---------------------------------------------------------------------

# [可选] 开发服务器默认端口 2607（bun run dev 经 scripts/dev.ts 启动，自动读取本文件）。
# 想换端口（例如与本机其他服务冲突）改这里即可；生产启动（bun run start）读 PORT，
# 同样可用环境变量 PANEL_PORT 覆盖，例如：PANEL_PORT=3000 bun run start
PANEL_PORT=2607

# [可选] 生产 standalone 启动端口（bun run start 脚本注入 PORT=${PANEL_PORT:-2607}）。
# 直连 bun .next/standalone/server.js 启动时若未设置 PORT，备份恢复等回退逻辑取 2607。
# 一般无需单独设置，与 PANEL_PORT 保持一致即可。
# PORT=2607


# ---------------------------------------------------------------------
# 二、面板鉴权机密（[必配-生产] 强烈建议生产部署显式注入）
# ---------------------------------------------------------------------

# [必配-生产] 面板鉴权密钥（32+ 位随机串）。注入后主服务与实时事件服务共享此字面量，
# 不再生成密钥文件。两服务变量名等价（PANEL_SECRET 主服务名，RAG_EVENTS_SECRET 历史别名），
# 任选其一注入即可，两服务双向兼容。未注入则首次面板登录后自动生成 db/.panel.secret 文件。
# 生成示例：openssl rand -hex 32
# PANEL_SECRET=

# [可选] 密钥文件路径（绝对路径优先）。两服务变量名等价。默认 db/.panel.secret（相对 cwd）。
# standalone 部署若 cwd 与项目根不同，建议显式指定同一绝对路径，避免两服务读到不同文件。
# PANEL_SECRET_FILE=/data/inkrag/db/.panel.secret
# RAG_EVENTS_SECRET_FILE=/data/inkrag/db/.panel.secret

# [可选] 面板初始口令（覆盖首次启动随机生成）。注入后首次播种直接使用此口令，
# 不再随机生成 / 写 db/.panel.pass。建议生产部署注入一个强口令，登录后立即在
# 「设置 → 面板安全」修改。未注入则首次启动随机生成 32 位口令并打印到 stdout。
# PANEL_INITIAL_PASSWORD=

# [可选] 初始口令文件路径（默认 db/.panel.pass，相对 cwd）。
# PANEL_INITIAL_PASS_FILE=/data/inkrag/db/.panel.pass


# ---------------------------------------------------------------------
# 三、实时事件服务（mini-services/pipeline-events，需单独启动）
# ---------------------------------------------------------------------

# socket.io 端口 2608（前端 io('/?XTransformPort=2608')）· 内部 emit HTTP 端口 2609（仅本机）
# 主服务侧 emit 地址默认 http://127.0.0.1:2609/emit，如需自定义可设置：
# [可选] emit 服务地址（主服务 → pipeline-events 服务间调用）
# RAG_EVENTS_EMIT_URL=http://127.0.0.1:2609/emit

# [可选] socket.io 服务端口（默认 2608，与常见 3000 段服务冲突而迁移）
# 推荐用命名空间变量 RAG_EVENTS_SOCKET_PORT；SOCKET_PORT 为旧名兼容
# RAG_EVENTS_SOCKET_PORT=2608
# SOCKET_PORT=2608

# [可选] 内部 emit HTTP 端口（默认 2609，仅绑定 127.0.0.1）
# 推荐用命名空间变量 RAG_EVENTS_EMIT_PORT；EMIT_PORT 为旧名兼容
# RAG_EVENTS_EMIT_PORT=2609
# EMIT_PORT=2609


# ---------------------------------------------------------------------
# 四、运行时与产物
# ---------------------------------------------------------------------

# [可选] SQLite 数据库路径（首次运行前执行 bun run db:push 初始化）
DATABASE_URL=file:./db/custom.db

# [可选] 文档解析产物（markdown / chunk / 图片）根目录（默认项目根 artifacts/）。
# 大量文件部署可指向独立数据盘。
# RAG_ARTIFACTS_DIR=/data/inkrag/artifacts


# ---------------------------------------------------------------------
# 五、监控
# ---------------------------------------------------------------------

# [必配-生产] Prometheus 抓取 /api/metrics 的 scrape token（≥16 位）。
# 配置后 /api/metrics 需要 ?token=xxx 或 Authorization: Bearer xxx 命中才放行
# （或已登录面板会话）。未配置则 /api/metrics 仅面板会话可访问，匿名抓取返回 401。
# 生成示例：openssl rand -hex 16
# METRICS_SCRAPE_TOKEN=
