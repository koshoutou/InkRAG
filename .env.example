# ===== 面板端口 =====
# 开发服务器默认端口 2607（bun run dev 经 scripts/dev.ts 启动，自动读取本文件）。
# 想换端口（例如与本机其他服务冲突）改这里即可；生产启动（bun run start）读 PORT，
# 同样可用环境变量 PANEL_PORT 覆盖，例如：PANEL_PORT=3000 bun run start
PANEL_PORT=2607

# ===== 数据库 =====
# SQLite 数据库路径（首次运行前执行 bun run db:push 初始化）
DATABASE_URL=file:./db/custom.db

# ===== 实时事件服务（mini-services/pipeline-events，需单独启动） =====
# socket.io 端口 2608（前端 io('/?XTransformPort=2608')）· 内部 emit HTTP 端口 2609（仅本机）
# 主服务侧 emit 地址默认 http://127.0.0.1:2609/emit，如需自定义可设置：
# RAG_EVENTS_EMIT_URL=http://127.0.0.1:2609/emit
