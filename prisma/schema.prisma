// RAG 知识库平台 · Prisma Schema
// 基座：qdrant-workbench-1.0.0 (QdrantSetting / QdrantCallLog)
// 扩展：KnowledgeBase / Document / Chunk / PipelineJob / ApiKey / VectorPoint
// 依据：《RAG知识库平台_开发计划书_超级详细版.md》§9.1（数据层契约）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 平台设置（单行记录，id 固定为 "default"）—— 承接基座 QdrantSetting 并扩展
// ---------------------------------------------------------------------------
model QdrantSetting {
  id                String   @id @default("default")

  // ---- Qdrant 连接（基座原有）----
  url               String   @default("")
  apiKey            String   @default("")
  defaultCollection String   @default("")

  // ---- Embedding（OpenAI 兼容，基座原有）----
  embedApiBase      String   @default("")
  embedApiKey       String   @default("")
  embedModel        String   @default("")

  // ---- Rerank（OpenAI 兼容，基座原有）----
  rerankApiBase     String   @default("")
  rerankApiKey      String   @default("")
  rerankModel       String   @default("")

  // ---- MinerU 解析服务（三 Provider：指南《MinerU_API_完整指南》）----
  /// selfhost（自部署 V1，六步协议）| cloud（官方云·精准 v4，Token）| cloud-agent（官方云·Agent 轻量，免 Token）
  mineruProvider   String   @default("selfhost") // selfhost | cloud | cloud-agent
  /// selfhost：V1 API 根地址（如 http://host:8000）；cloud/cloud-agent 固定 mineru.net，此字段不参与
  mineruApiUrl      String   @default("")
  /// selfhost：V1 可选鉴权；cloud：API Token（必填）；cloud-agent：不使用
  mineruApiKey      String   @default("")
  mineruTier        String   @default("standard") // flash | basic | standard | advanced（仅 selfhost）
  mineruOcrMode     String   @default("auto")     // auto | txt | ocr（仅 selfhost）

  // ---- 平台行为开关 ----
  /// 未配置 MinerU 时是否启用内置降级解析器（文本/PDF 直解，非 MinerU）
  useFallbackParser Boolean   @default(true)
  /// 显式开启确定性 Mock 嵌入（离线调试用；默认关闭，未配置真实 Embedding 时嵌入硬失败）
  useMockEmbedding  Boolean   @default(false)
  /// 显式开启词法重排（BM25 近似，离线调试用；默认关闭）
  useMockRerank     Boolean   @default(true)

  // ---- 备份定时任务（进程内调度器，globalThis 单例） ----
  autoBackupEnabled       Boolean @default(false)
  /// 自动备份间隔（小时，2-168）
  autoBackupIntervalHours Int     @default(24)
  /// 保留最近 N 份自动备份（轮转清理，2-50）
  autoBackupKeep          Int     @default(5)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// 检索调用日志（基座 QdrantCallLog —— 即计划书 §9.1 retrieval_log，可回放）
// ---------------------------------------------------------------------------
model QdrantCallLog {
  id             String   @id @default(cuid())
  /// 调用者来源：web-ui | external | debug-console
  source         String   @default("web-ui")
  collection     String
  query          String   @default("")
  /// 检索方式：dense | sparse | hybrid
  mode           String
  topK           Int      @default(10)
  scoreThreshold Float    @default(0)
  reranked       Boolean  @default(false)
  tookMs         Int      @default(0)
  resultCount    Int      @default(0)
  /// JSON：完整参数（filter / fusion / rrfK / embed_model / rerank_model 等）
  paramsJson     String   @default("{}")
  /// JSON：结果预览（id / score / payload 摘要 / doc / page）
  resultsJson    String   @default("[]")
  /// JSON：四阶段调试信息（embedStats / dense / sparse / fused / rerank / stages 耗时）
  debugJson      String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([collection])
  @@index([createdAt])
  @@index([source])
}

// ---------------------------------------------------------------------------
// 知识库（计划书 §9.1 knowledge_base —— 一库一 Qdrant 集合 kb_{id}）
// ---------------------------------------------------------------------------
model KnowledgeBase {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String   @default("")
  /// Qdrant collection 名：kb_{id 去掉特殊字符}
  collection       String   @unique
  /// 嵌入模型名（建库时锁定，不可中途换模型 —— 换模型 = 新建库重导）
  embeddingModel   String   @default("")
  /// 向量维度（建库时锁定；0 表示尚未探测）
  dim              Int      @default(0)
  /// 切分配置（计划书 §11.3 契约）
  /// { size: 512, overlap: 0, parentSize: 2000, strategy: "hybrid", protects: ["code","table"] }
  chunkConfig      String   @default("{\"size\":512,\"overlap\":0,\"parentSize\":2000,\"strategy\":\"hybrid\",\"protects\":[\"code\",\"table\"]}")
  /// 向量存储模式（v1.6 起仅 qdrant；本地引擎已移除，未配置 Qdrant 时建库硬失败）
  vectorMode       String   @default("qdrant")
  /// 稀疏向量方案锁定（建库时探测写入，防止两种 sparse 空间静默混用）：
  /// none（provider 无稀疏输出，检索强制 dense）| native（provider 原生稀疏，写入时断言非空）
  sparseScheme     String   @default("none")
  /// 是否启用 Rerank（库级默认）
  rerankEnabled    Boolean  @default(false)
  docCount         Int      @default(0)
  chunkCount       Int      @default(0)
  pointCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documents        Document[]
  chunks           Chunk[]
  testCases        RetrievalTestCase[]

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 检索测试集用例（回归测试：期望命中文档 + 参数快照 + 最近一次运行结果）
// ---------------------------------------------------------------------------
model RetrievalTestCase {
  id          String   @id @default(cuid())
  kbId        String
  name        String
  query       String
  /// 期望命中的文档 ID 列表 JSON string[]（金标准）
  expectDocIds String  @default("[]")
  /// 期望命中的 chunk ID 列表 JSON string[]（可选更严格金标准：非空时 pass 需全部命中）
  expectChunkIds String @default("[]")
  /// 检索参数快照 JSON（mode/topK/rerank/fusion/rrfK/rrfWeights 等）
  paramsJson  String   @default("{}")
  /// 最近一次运行结果摘要 JSON（pass/hitRate/mrr/tookMs/ranAt/hits/misses）
  lastRunJson String   @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kb          KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  @@index([kbId])
}

// ---------------------------------------------------------------------------
// 文档生命周期（计划书 §9.1 document —— 状态机 §10.2）
// ---------------------------------------------------------------------------
model Document {
  id             String   @id @default(cuid())
  kbId           String
  filename       String
  mimeType       String   @default("")
  sizeBytes      Int      @default(0)
  /// sha256 流式哈希（秒传判定）
  contentHash    String
  /// 状态机：queued → parsing → chunking → embedding → upserting → ready | failed
  status         String   @default("queued")
  /// 各阶段内部进度 0-100
  stageProgress  Int      @default(0)
  parseConfigV   Int      @default(1)
  /// 切分参数快照（JSON，重切时对比）
  chunkConfigSnap String  @default("{}")
  errorCode      String?
  errorMessage   String?
  /// MinerU 任务 ID（断点续传：q1 重试先查旧 job）
  mineruJobId    String?
  mineruUploadId String?
  mineruFileId   String?
  /// 解析引擎：mineru | fallback
  parseEngine    String   @default("")
  /// 产物相对路径 {kbId}/{docId}/
  storageKey     String   @default("")
  /// middle.json 解析出的块数（可视化用）
  layoutBlocks   Int      @default(0)
  /// URL 导入来源（空 = 本地上传；契约 §26）
  sourceUrl      String   @default("")
  /// 元信息 JSON（页数、字符数、解析耗时等）
  metaJson       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kb             KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  chunks         Chunk[]

  @@unique([kbId, contentHash, parseConfigV])
  @@index([kbId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Chunk 溯源（计划书 §9.1 chunk —— 父子索引 + 坐标链路 §6.4/§13.2）
// ---------------------------------------------------------------------------
model Chunk {
  /// 确定性 ID：uuidv5(`${kbId}:${docId}:${seq}:${textHash}`, NAMESPACE) —— 重跑不产生重复向量
  id             String   @id
  documentId     String
  kbId           String
  /// 是否父 chunk（章节级，≤ parentMaxTokens）
  isParent       Boolean  @default(false)
  parentId       String?
  /// 文档内顺序
  seq            Int      @default(0)
  docType        String   @default("text") // text | table | code | image
  tokenCount     Int      @default(0)
  /// 源 markdown 字符范围（可视化高亮用）
  charStart      Int      @default(0)
  charEnd        Int      @default(0)
  /// 坐标链路（计划书 §6.4 payload 契约）：1-based 页码，PDF 点空间 [x0,y0,x1,y1]
  pageFrom       Int      @default(0)
  pageTo         Int      @default(0)
  bboxFrom       String   @default("[]") // JSON [x0,y0,x1,y1]
  bboxTo         String   @default("[]")
  /// ≤500 字符预览（全文在 chunks/{id}.txt）
  textPreview    String   @default("")
  storageKey     String   @default("")
  /// 软禁用开关（对标 RAGFlow：禁用 chunk 仍保留但不参与检索）
  enabled        Boolean  @default(true)
  /// 人工编辑时间（M6 T6.6：编辑后重嵌入；原文备份在 chunks/{id}.orig.txt）
  editedAt       DateTime?
  createdAt      DateTime @default(now())

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kb             KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([kbId])
  @@index([parentId])
  @@index([seq])
}

// ---------------------------------------------------------------------------
// 流水线任务（BullMQ 适配：SQLite 队列 + 进程内引擎）
// ---------------------------------------------------------------------------
model PipelineJob {
  id             String   @id @default(cuid())
  documentId     String
  kbId           String
  /// parse | chunk | embed | upsert
  type           String
  /// pending | active | completed | failed | retrying
  status         String   @default("pending")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  payloadJson    String   @default("{}")
  error          String?
  /// 阶段耗时 ms
  durationMs     Int      @default(0)
  /// 心跳时间戳（活跃 job 每 30s 续租；僵死回收改为心跳驱动，替代固定 10 分钟阈值）
  heartbeatAt    DateTime?
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([status, type])
  @@index([documentId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Agent API Key（计划书 M8：对外检索 API 鉴权）
// ---------------------------------------------------------------------------
model ApiKey {
  id             String   @id @default(cuid())
  name           String
  /// 兼容列：仅存量明文 key 迁移前使用；校验命中后即升级为 keyHash 并清空此列
  key            String   @unique
  /// sha256(key) 十六进制（64 位定长；timingSafeEqual 比对）
  keyHash        String   @default("")
  /// key 前缀（如 lkb-xx…，用于 UI 展示与掩码）
  keyPrefix      String   @default("")
  /// admin | operator | readonly（debug 权限 = operator+）
  role           String   @default("readonly")
  enabled        Boolean  @default(true)
  lastUsedAt     DateTime?
  callCount      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([keyHash])
}

// ---------------------------------------------------------------------------
// 内置本地向量引擎（沙箱演示模式：无 Qdrant 时的数据面）
// 注意：生产环境请配置真实 Qdrant（N5 红线的沙箱豁免项，代码中有明确标注）
// ---------------------------------------------------------------------------
// （v1.6 移除）VectorPoint：本地向量引擎专用表已随 LocalVectorStore 一并删除
// 生产向量一律写入 Qdrant；未配置/不可达时写入硬失败，绝不静默降级
